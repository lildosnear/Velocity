# Velocity environment. Copy this file to .env and fill it in.
# The file as shipped is a complete TESTNET configuration. To run on
# mainnet instead, follow the MAINNET section at the bottom: it lists
# every line that changes. Never mix the two networks in one .env, and
# never run mainnet with the testnet DATA_DIR (user wallets and the
# trade ledger live there, encrypted under MASTER_KEY).

TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
MASTER_KEY=

# Master trading switch. Leave true for normal running. Set false to
# pause all trading (buys, sells, trader alert buttons and AI copy
# executions refuse plainly) while balances, watch lists and info
# commands keep working.
TRADING_ENABLED=true

# ----------------------------------------------------------------
# TESTNET (default)
# ----------------------------------------------------------------
NEAR_NETWORK=testnet
# NEAR RPC endpoints, comma separated, in failover order. When an
# endpoint rate limits (HTTP 429, or the legacy endpoint's -429
# deprecation error) or drops a call, the bot retries the same call
# against the next endpoint instead of failing the command. Leave the
# line as is for the built in defaults: testnet FastNear, dRPC, then
# the legacy NEAR endpoint; mainnet uses the matching mainnet set.
NEAR_RPC_URL=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org,https://rpc.testnet.near.org
REF_EXCHANGE_ID=ref-finance.testnet
# DCL (concentrated liquidity) exchange. Mainnet: dclv2.ref-labs.near.
# No DCL deployment exists on testnet today, so on testnet the DCL scan
# simply finds no pools and simple pool routes carry the trades.
DCL_EXCHANGE_ID=dclv2.ref-labs.testnet
WNEAR_ID=wrap.testnet
# Testnet has no canonical USDC or USDT. These defaults point at the Ref
# testnet fake tokens; replace them if you use different test tokens.
USDC_CONTRACT_ID=usdc.fakes.testnet
USDT_CONTRACT_ID=usdt.fakes.testnet
# Per trade cap in NEAR value. Testnet default 10 (play money).
MAX_TRADE_NEAR=10
DATA_DIR=./data

# ----------------------------------------------------------------
# Shared settings (same on both networks)
# ----------------------------------------------------------------
# Fee wallet (run: npm run make-fee-wallet). velocitybot.testnet is the
# recommended testnet fee account name, velocitybot.near on mainnet.
# Leave FEE_ACCOUNT_ID empty and fees are skipped cleanly with a log
# line until you set it.
FEE_ACCOUNT_ID=
FEE_ACCOUNT_SECRET_ENC=
# Named wallet creator (run: npm run make-creator-wallet). The creator
# is a funded account that signs create_account calls on the network
# registrar (testnet here, near on mainnet) when a user gets a named
# wallet from their Telegram username or /name. On mainnet the
# recommended creator is velocitybot.near itself: encrypt its key with
# npm run smoke -- --encrypt-key "ed25519:..." instead of making an
# implicit wallet. Leave both empty and named wallets stay off: every
# user keeps the implicit hex wallet.
CREATOR_ACCOUNT_ID=
CREATOR_SECRET_ENC=
# Starter deposit attached to each named account creation. It lands in
# the user's new account as its starting balance, it is not burned.
# 0.01 makes the fresh account able to send immediately (the node's
# worst case gas prepayment headroom measured live was about 0.0081).
NAME_CREATION_DEPOSIT_NEAR=0.01
BOT_FEE_BPS=100
SLIPPAGE_BPS=100
PRICE_TTL_SECS=15
WATCH_POLL_SECS=20
# Watcher token discovery: cap on discovered tokens tracked per poll
# and how long the discovered set is cached, in seconds.
WATCH_DISCOVERY_MAX=250
WATCH_DISCOVERY_TTL_SECS=600
# Trader alert Buy buttons: NEAR spent per tap when the user has no AI
# per trade size configured. With an AI size set, the button uses that
# size instead. MAX_TRADE_NEAR caps either way.
ALERT_BUY_NEAR=0.1
REFERRAL_ENABLED=true
REFEREE_DISCOUNT_PCT=25
REFERRER_BONUS_PCT=25
REFERRAL_TRADE_LIMIT=10
DEFAULT_PAY_CURRENCY=NEAR
# Extra tokens for /tokens and the watcher registry, as JSON:
# KNOWN_TOKENS=[{"id":"wrap.testnet","symbol":"wNEAR","decimals":24}]
KNOWN_TOKENS=

# ----------------------------------------------------------------
# MAINNET: replace the TESTNET block above with these values.
# Use a separate Telegram bot (BotFather) and its own DATA_DIR so
# testnet users and data never mix with real money. See the MAINNET
# section of the README for the full runbook.
# ----------------------------------------------------------------
# NEAR_NETWORK=mainnet
# NEAR_RPC_URL=https://rpc.mainnet.fastnear.com,https://near.drpc.org,https://rpc.mainnet.near.org
# REF_EXCHANGE_ID=v2.ref-finance.near
# DCL_EXCHANGE_ID=dclv2.ref-labs.near
# WNEAR_ID=wrap.near
# USDC on mainnet defaults to the bridged USDC token (symbol USDC.e).
# The account usdc.near holds no contract code and is not a token.
# USDC_CONTRACT_ID=a0b86991c6218b36c1d19d4a2e9eb0ce3606eb48.factory.bridge.near
# USDT on mainnet defaults to the canonical Tether token (symbol USDt).
# USDT_CONTRACT_ID=usdt.tether-token.near
# Per trade cap in NEAR value. Mainnet default 5 (real money). The bot
# uses 5 on mainnet even if this line is deleted; the line is here so
# the value is visible and easy to raise deliberately.
# MAX_TRADE_NEAR=5
# DATA_DIR=./data-mainnet
