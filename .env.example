TELEGRAM_BOT_TOKEN=
BOT_USERNAME=
MASTER_KEY=
NEAR_NETWORK=testnet
# NEAR RPC endpoints, comma separated, in failover order. When an
# endpoint rate limits (HTTP 429, or the legacy endpoint's -429
# deprecation error) or drops a call, the bot retries the same call
# against the next endpoint instead of failing the command. Leave the
# line as is for the built in defaults: testnet FastNear, dRPC, then
# the legacy NEAR endpoint; mainnet uses the matching mainnet set.
NEAR_RPC_URL=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org,https://rpc.testnet.near.org
REF_EXCHANGE_ID=ref-finance.testnet
# DCL (concentrated liquidity) exchange. Mainnet: dclv2.ref-labs.near.
# No DCL deployment exists on testnet today, so on testnet the DCL scan
# simply finds no pools and simple pool routes carry the trades.
DCL_EXCHANGE_ID=dclv2.ref-labs.testnet
WNEAR_ID=wrap.testnet
# Fee wallet (run: npm run make-fee-wallet). velocitybot.testnet is the
# recommended testnet fee account name. Leave FEE_ACCOUNT_ID empty and
# fees are skipped cleanly with a log line until you set it.
FEE_ACCOUNT_ID=
FEE_ACCOUNT_SECRET_ENC=
BOT_FEE_BPS=100
SLIPPAGE_BPS=100
MAX_TRADE_NEAR=10
PRICE_TTL_SECS=15
WATCH_POLL_SECS=20
# Watcher token discovery: cap on discovered tokens tracked per poll
# and how long the discovered set is cached, in seconds.
WATCH_DISCOVERY_MAX=250
WATCH_DISCOVERY_TTL_SECS=600
REFERRAL_ENABLED=true
REFEREE_DISCOUNT_PCT=25
REFERRER_BONUS_PCT=25
REFERRAL_TRADE_LIMIT=10
DEFAULT_PAY_CURRENCY=NEAR
# Testnet has no canonical USDC or USDT. These defaults point at the Ref
# testnet fake tokens; replace them if you use different test tokens.
USDC_CONTRACT_ID=usdc.fakes.testnet
USDT_CONTRACT_ID=usdt.fakes.testnet
# Extra tokens for /tokens and the watcher registry, as JSON:
# KNOWN_TOKENS=[{"id":"wrap.testnet","symbol":"wNEAR","decimals":24}]
KNOWN_TOKENS=
DATA_DIR=./data
